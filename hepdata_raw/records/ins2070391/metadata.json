      "rho",
      "kappa2/kappa1"
    ],
    "reactions": [
      "Pb Pb --> $\\overline{p}$ + $X$, $\\overline{d}$ + $X$",
      "Pb Pb --> $\\overline{d}$ + $X$"
    ]
  },
